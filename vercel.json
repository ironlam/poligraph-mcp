{
  "buildCommand": "npm run build",
  "outputDirectory": "",
  "rewrites": [
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/landing.css", "destination": "/public/landing.css" },
    { "source": "/landing.js", "destination": "/public/landing.js" },
    { "source": "/logo.svg", "destination": "/public/logo.svg" },
    { "source": "/mcp", "destination": "/api/mcp" }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'none'; connect-src 'none'; font-src 'self'; form-action 'none'; frame-ancestors 'none'; img-src 'self'; object-src 'none'; script-src 'self'; style-src 'self'"
        }
      ]
    }
  ],
  "functions": {
    "api/mcp.ts": {
      "maxDuration": 60
    }
  }
}
